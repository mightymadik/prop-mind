# HTTPS от Let's Encrypt автоматически для {$DOMAIN}.
# Без своего домена: <публичный-IP-через-дефисы>.sslip.io — сертификат выпустится и на него.
{$DOMAIN} {
	reverse_proxy api:8000 {
		# SSE: отдавать события сразу, без буферизации
		flush_interval -1
	}
	# без encode: сжатие буферизует поток событий
}
